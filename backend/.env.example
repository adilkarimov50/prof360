# Скопируйте в .env и задайте реальные секреты в продакшене.
DATABASE_URL=postgresql+psycopg2://prof360:prof360@localhost:5432/prof360

# Секреты безопасности (ОБЯЗАТЕЛЬНО заменить в проде)
JWT_SECRET=change-me-in-production-please-use-long-random-secret
# Ключ Fernet (32 байта base64). Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=_Qk1lPrvsKtTzxT2ZwUFveJb_ItPyMofdiCQI-Lz0MA=
IIN_HASH_PEPPER=prof360-iin-pepper-change-me

# ИИ: провайдер генерации — "gemini" (внешний API) или "ollama" (локально)
AI_PROVIDER=gemini
# Google Gemini (вставьте ваш ключ; ПДн токенизируются перед отправкой)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Разрешить внешний ИИ (ПДн всё равно обезличиваются токенизацией)
AI_ALLOW_EXTERNAL=true

# Локальный резерв (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=true

# Каталог с исходными Excel (адм. практика, алкоголь, ЕРДР, проф дела)
DATA_DIR=..

# Учётные данные по умолчанию (сменить после первого входа)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=Prof360!admin
DEFAULT_PROSECUTOR_PASSWORD=Prof360!prok
